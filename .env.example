# Copy to ".env" for local use. On a server, set these as environment variables instead.

# 32 random bytes as 64 hex characters. Protects every CV file, saved password and backup.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy in a password manager: without it the vault and backups cannot be opened.
# If left empty, a key file is created at data/master.key on first start.
MASTER_KEY=

# Where the database, the encrypted vault and backups live. Must be a real, persistent disk.
DATA_DIR=data
# BACKUP_DIR=/var/backups/guardora    (better on a different disk)
# BACKUP_KEEP=30

PORT=8787
# HOST=127.0.0.1          (when a reverse proxy such as nginx sits in front)
# NODE_ENV=production     (secure cookies, HSTS)
# TRUST_PROXY=1           (behind nginx / Cloudflare / Hostinger proxy)

# Optional: choose the one-time setup code instead of a random one printed in the log.
# SETUP_CODE=

# MAX_UPLOAD_MB=20
